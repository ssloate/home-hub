.notifications-page {
  animation: fadeIn 0.3s ease-out;
}

.notifications-page .page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}

.notifications-container {
  background: white;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.notifications-list {
  padding: 0.5rem;
}

.notification-card {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1.25rem;
  border-radius: var(--radius);
  margin-bottom: 0.5rem;
  background: var(--neutral-50);
  transition: var(--transition);
}

.notification-card.unread {
  background: linear-gradient(135deg, var(--primary-50) 0%, var(--secondary-50) 100%);
  border-left: 4px solid var(--primary-500);
}

.notification-card:hover {
  background: var(--neutral-100);
}

.notification-card.unread:hover {
  background: var(--primary-100);
}

.notification-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.notification-icon .icon-warning {
  color: var(--warning);
}

.notification-icon .icon-error {
  color: var(--error);
}

.notification-icon .icon-primary {
  color: var(--primary-500);
}

.notification-content {
  flex: 1;
}

.notification-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 0.375rem;
}

.notification-header h3 {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--neutral-900);
}

.notification-time {
  font-size: 0.75rem;
  color: var(--neutral-500);
  white-space: nowrap;
}

.notification-message {
  font-size: 0.875rem;
  color: var(--neutral-600);
  line-height: 1.5;
  margin-bottom: 0.5rem;
}

.notification-card .priority-badge {
  font-size: 0.6875rem;
}

.notification-actions {
  display: flex;
  gap: 0.25rem;
  opacity: 0;
  transition: var(--transition);
}

.notification-card:hover .notification-actions {
  opacity: 1;
}

/* Empty State */
.notifications-container .empty-state {
  padding: 4rem 2rem;
  text-align: center;
  color: var(--neutral-400);
}

.notifications-container .empty-state svg {
  color: var(--neutral-300);
}

.notifications-container .empty-state h3 {
  margin-top: 1rem;
  color: var(--neutral-600);
}

.notifications-container .empty-state p {
  margin-top: 0.5rem;
  font-size: 0.875rem;
}

/* Responsive */
@media (max-width: 640px) {
  .notification-card {
    flex-direction: column;
    gap: 0.75rem;
  }

  .notification-header {
    flex-direction: column;
    gap: 0.25rem;
  }

  .notification-actions {
    opacity: 1;
    justify-content: flex-end;
  }
}
