.dashboard {
  animation: fadeIn 0.3s ease-out;
}

/* Welcome Section */
.welcome-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  gap: 1.5rem;
  background: linear-gradient(135deg, white 0%, var(--primary-50) 50%, var(--secondary-50) 100%);
  padding: 2rem;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow);
  position: relative;
  overflow: hidden;
}

.welcome-content {
  position: relative;
  z-index: 1;
}

.welcome-decoration {
  position: absolute;
  top: -10px;
  left: -10px;
  opacity: 0.5;
}

.welcome-content h1 {
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--neutral-900);
  margin-bottom: 0.25rem;
}

.welcome-content p {
  color: var(--neutral-500);
  font-size: 0.9375rem;
}

.welcome-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
}

.house-illustration {
  width: 140px;
  height: auto;
  border-radius: var(--radius-lg);
  filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
  animation: floatHouse 3s ease-in-out infinite;
}

@keyframes floatHouse {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

.property-badge {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  background: white;
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
  font-size: 0.875rem;
  color: var(--neutral-700);
}

.property-badge svg {
  color: var(--primary-500);
}

/* Stats Grid */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem;
  margin-bottom: 2rem;
}

.stat-card {
  background: white;
  border-radius: var(--radius-lg);
  padding: 1.25rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  box-shadow: var(--shadow);
  transition: var(--transition);
}

.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.stat-card.clickable {
  cursor: pointer;
  text-decoration: none;
  color: inherit;
}

.stat-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon.overdue {
  background: var(--error-light);
  color: var(--error);
}

.stat-icon.due-soon {
  background: var(--warning-light);
  color: #b45309;
}

.stat-icon.completed {
  background: var(--secondary-100);
  color: var(--secondary-600);
}

.stat-icon.spent {
  background: var(--primary-100);
  color: var(--primary-600);
}

.stat-content {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--neutral-900);
  line-height: 1.2;
}

.stat-label {
  font-size: 0.8125rem;
  color: var(--neutral-500);
}

/* Dashboard Grid */
.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

.dashboard-card {
  background: white;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  overflow: hidden;
}

.dashboard-card .card-header {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--neutral-100);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.card-title svg {
  color: var(--primary-500);
}

.card-title h2 {
  font-size: 1rem;
  font-weight: 600;
  color: var(--neutral-900);
}

.card-link {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.8125rem;
  color: var(--primary-600);
  font-weight: 500;
}

.card-link:hover {
  color: var(--primary-500);
}

.card-header.clickable-header {
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  transition: var(--transition);
}

.card-header.clickable-header:hover {
  background: var(--primary-50);
}

.card-header.clickable-header .header-arrow {
  color: var(--neutral-400);
  transition: var(--transition);
}

.card-header.clickable-header:hover .header-arrow {
  color: var(--primary-500);
  transform: translateX(2px);
}

.dashboard-card .card-body {
  padding: 1rem 1.5rem;
}

.dashboard-card .card-footer {
  padding: 1rem 1.5rem;
  background: var(--neutral-50);
  border-top: 1px solid var(--neutral-100);
}

/* Task List */
.task-list {
  display: flex;
  flex-direction: column;
}

.task-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.875rem 0;
  border-bottom: 1px solid var(--neutral-100);
}

.task-item:last-child {
  border-bottom: none;
}


.task-info {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.task-name {
  font-weight: 500;
  color: var(--neutral-800);
  font-size: 0.9375rem;
}

.task-category {
  font-size: 0.75rem;
  color: var(--neutral-500);
}

.task-due {
  display: flex;
  align-items: center;
  gap: 0.625rem;
}

.due-badge {
  padding: 0.25rem 0.625rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 500;
}

.due-badge.overdue {
  background: var(--error-light);
  color: #b91c1c;
}

.due-badge.today {
  background: var(--warning-light);
  color: #b45309;
}

.due-badge.soon {
  background: var(--primary-100);
  color: var(--primary-600);
}

.due-badge.upcoming {
  background: var(--neutral-100);
  color: var(--neutral-600);
}

.priority-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
}

.priority-dot.priority-low {
  background: var(--secondary-400);
}

.priority-dot.priority-medium {
  background: var(--warning);
}

.priority-dot.priority-high {
  background: var(--error);
}

/* Cost List */
.cost-list {
  display: flex;
  flex-direction: column;
}

.cost-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.875rem 0;
  border-bottom: 1px solid var(--neutral-100);
}

.cost-item:last-child {
  border-bottom: none;
}

.cost-info {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.cost-name {
  font-weight: 500;
  color: var(--neutral-800);
  font-size: 0.9375rem;
}

.cost-category {
  font-size: 0.75rem;
  color: var(--neutral-500);
}

.cost-amount {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.125rem;
}

.cost-amount > span:first-child {
  font-weight: 600;
  color: var(--neutral-900);
}

.cost-date {
  font-size: 0.75rem;
  color: var(--neutral-500);
}

.cost-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cost-summary > span:first-child {
  font-size: 0.875rem;
  color: var(--neutral-600);
}

.cost-total {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--neutral-900);
}

/* Quick Links */
.quick-links {
  display: flex;
  gap: 1rem;
}

.quick-link {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  padding: 1.25rem 1rem;
  background: var(--neutral-50);
  border-radius: var(--radius);
  transition: var(--transition);
}

.quick-link:hover {
  background: var(--neutral-100);
  transform: translateY(-2px);
}

.quick-link-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.quick-link-icon.rooms {
  background: linear-gradient(135deg, var(--primary-400) 0%, var(--primary-500) 100%);
}

.quick-link-icon.maintenance {
  background: linear-gradient(135deg, var(--secondary-400) 0%, var(--secondary-500) 100%);
}

.quick-link-icon.costs {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
}

.quick-link span {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--neutral-700);
}

/* Property Details */
.property-details {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem;
}

.property-detail {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.detail-label {
  font-size: 0.75rem;
  color: var(--neutral-500);
}

.detail-value {
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--neutral-800);
}

.property-features {
  margin-top: 1.25rem;
  padding-top: 1rem;
  border-top: 1px solid var(--neutral-100);
}

.features-label {
  display: block;
  font-size: 0.75rem;
  color: var(--neutral-500);
  margin-bottom: 0.5rem;
}

.features-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.feature-tag {
  padding: 0.25rem 0.625rem;
  background: linear-gradient(135deg, var(--primary-50) 0%, var(--secondary-50) 100%);
  color: var(--primary-600);
  font-size: 0.75rem;
  border-radius: 9999px;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  color: var(--neutral-400);
}

.empty-state svg {
  margin-bottom: 0.75rem;
}

.empty-state p {
  font-size: 0.875rem;
}

/* Responsive */
@media (max-width: 1200px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .welcome-section {
    flex-direction: column;
    align-items: flex-start;
    padding: 1.5rem;
  }

  .welcome-visual {
    width: 100%;
    align-items: center;
  }

  .house-illustration {
    width: 80px;
    height: 80px;
  }

  .welcome-decoration {
    display: none;
  }

  .property-details {
    grid-template-columns: 1fr;
  }

  .quick-links {
    flex-direction: column;
  }
}
